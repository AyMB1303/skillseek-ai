# Copier en `.env` et adapter. Le fichier `.env` reel n'est jamais versionne.

# --- PostgreSQL ---
POSTGRES_USER=skillseek
POSTGRES_PASSWORD=skillseek_dev_password
POSTGRES_DB=skillseek
DATABASE_URL=postgresql://skillseek:skillseek_dev_password@db:5432/skillseek

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-too-in-production

# --- Compte administrateur initial ---
# Créé par `flask seed`. Les valeurs ci-dessous sont celles de la
# démonstration : un déploiement réel doit les redéfinir AVANT le premier
# amorçage, le mot de passe étant public dans ce fichier d'exemple.
# ADMIN_EMAIL=admin@skillseek.local
# ADMIN_PASSWORD=Admin@1234

# --- Chemins de travail ---
# Tous ont une valeur par défaut adaptée au conteneur ; ces lignes ne
# servent qu'à une exécution hors Docker ou à un stockage monté ailleurs.
# UPLOAD_FOLDER=/app/uploads          CV déposés
# BI_EXPORT_DIR=/app/exports          exports décisionnels
# CHEMIN_MODELE=/app/models/correspondance.joblib

# Empreinte du commit, inscrite dans le bloc de provenance de chaque analyse.
# Renseignée automatiquement par la chaîne de déploiement.
# GIT_SHA=inconnu

# --- Navigateur ---
# Origines autorisees a appeler l'API. Plusieurs valeurs separees par des
# virgules. Laisser vide reviendrait a n'autoriser personne : la valeur par
# defaut couvre le poste de developpement.
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Connexion ---
# Au-dela de LOGIN_MAX_ECHECS tentatives infructueuses consecutives, le compte
# vise refuse les tentatives pendant LOGIN_VERROU_MINUTES minutes. Une
# connexion reussie remet le compteur a zero.
LOGIN_MAX_ECHECS=5
LOGIN_VERROU_MINUTES=10

# --- Assistant : modele de langue local (facultatif) ---
# Si Ollama ne repond pas, l'assistant bascule sur la redaction deterministe
# sans interruption de service. Aucune cle, aucun service payant.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
# Duree pendant laquelle le modele reste charge en memoire entre deux
# questions ; sans cela, Ollama le decharge et la question suivante paie un
# rechargement depuis le disque.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=300

# --- Assistant : service distant (desactive par defaut) ---
# Renseigner une cle bascule la generation sur un service externe. Le projet
# est concu pour s'en passer : ne rien mettre ici est le mode nominal.
# LLM_API_KEY=
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
