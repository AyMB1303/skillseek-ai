# Ce fichier répond à une seule question : ce contenu est-il RECRÉABLE, ou
# n'a-t-il rien à faire dans un dépôt ? Tout le reste est versionné, y
# compris les livrables — rapports, captures, fichier Power BI — qui sont la
# preuve du travail et pèsent, à eux tous, quelques mégaoctets.

# --- Python ---------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# --- Secrets --------------------------------------------------------------
# Seul `.env.example` est versionné : il documente les variables attendues
# sans en livrer aucune valeur réelle.
.env
.env.*
!.env.example

# --- Node / Next ----------------------------------------------------------
node_modules/
.next/
out/
.eslintcache
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Tests de bout en bout (à venir) --------------------------------------
playwright-report/
test-results/
blob-report/
.playwright/

# --- Sorties de la chaîne d'intégration -----------------------------------
# Rapports d'analyse et inventaires logiciels : produits à chaque exécution
# et conservés comme artefacts par GitHub, pas dans l'historique.
*.sarif
sbom-*.json
trivy-*.json

# --- IDE / système --------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store

# --- Données personnelles -------------------------------------------------
# Les CV déposés ne doivent JAMAIS sortir de la machine qui les héberge.
backend/uploads/
backend/instance/

# --- Volumineux et régénérable --------------------------------------------
# Corpus d'apprentissage : retéléchargeable depuis sa source.
data/*.csv
# Modèles entraînés à la racine : espace de travail, reproduits par
# `python entrainer_modele.py`. Rien n'a besoin d'en garder l'historique.
models/*.joblib

# `backend/models/` échappe volontairement à cette règle, et n'est donc PAS
# ignoré. Ce dossier est dans le contexte de construction de l'image : le
# modèle qui s'y trouve est embarqué, ce qui rend l'image autonome.
#
# Sans cela, l'instance déployée tournait sans le modèle — le fichier
# n'existait que sur le poste de développement, où le montage de volume du
# Compose le rendait visible. La sonde de disponibilité l'annonçait
# honnêtement (`modele_appris: false`), mais l'ajustement borné de ±8 points
# ne s'appliquait pas en ligne.
#
# Douze mégaoctets versionnés est le prix d'une image qui contient tout ce
# qu'il lui faut pour fonctionner, où qu'elle tourne.
models/cache/
models/*.json
# Exports décisionnels : reproduits par `flask bi-export`, et porteurs de
# données de candidatures.
exports/*.csv

# --- Archives -------------------------------------------------------------
# Maquettes HTML ayant servi à concevoir l'interface, remplacées par le
# frontend Next.js : ni compilées, ni servies.
design/

# --- LaTeX ----------------------------------------------------------------
# Seuls le .tex (source) et le .pdf (livrable, lisible sans installer LaTeX)
# sont versionnés. Tout le reste est reproduit à chaque compilation.
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.lof
docs/*.lot
docs/*.bbl
docs/*.blg
docs/*.nav
docs/*.snm
docs/*.vrb
docs/*.synctex.gz
docs/*.fls
docs/*.fdb_latexmk

# Rapports de couverture de l'interface
frontend/coverage/

# Dossier de travail scolaire : rapports, captures et figures du PFA.
# Il vit sur le disque a cote du code, mais n'appartient pas au produit.
_Ecole/
