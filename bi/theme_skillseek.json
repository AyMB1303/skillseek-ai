{
  "name": "SkillSeek AI",
  "dataColors": [
    "#2E86AB",
    "#1F3A5F",
    "#2E7D5B",
    "#B5820A",
    "#C1502E",
    "#6B7A8F",
    "#5AA9C9",
    "#3F5F87",
    "#4FA37E",
    "#D9A93C"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F3A5F",
  "foregroundNeutralSecondary": "#4A5C75",
  "foregroundNeutralTertiary": "#6B7A8F",
  "backgroundLight": "#EEF4F8",
  "backgroundNeutral": "#DCE6EE",
  "tableAccent": "#2E86AB",
  "good": "#2E7D5B",
  "neutral": "#B5820A",
  "bad": "#C1502E",
  "maximum": "#1F3A5F",
  "center": "#5AA9C9",
  "minimum": "#EEF4F8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1F3A5F"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4A5C75"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 34,
      "color": "#1F3A5F"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1F3A5F"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#DCE6EE" } },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#1F3A5F" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "color": { "solid": { "color": "#1F3A5F" } },
            "position": "Outer",
            "preset": "BottomRight",
            "shadowSpread": 3,
            "transparency": 88
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F4F7FA" } },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": { "solid": { "color": "#F4F7FA" } }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#1F3A5F" } },
            "fontSize": 30,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": { "solid": { "color": "#6B7A8F" } },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#EEF4F8" } },
            "rowPadding": 4
          }
        ],
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#1F3A5F" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
