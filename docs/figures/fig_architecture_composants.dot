digraph composants {

  graph [fontname="Helvetica", fontsize=11, bgcolor="#FFFFFF", pad=0.3,
         fontcolor="#12324F"];
  node  [fontname="Helvetica", fontsize=11, color="#12324F", penwidth=1.4,
         fontcolor="#12324F"];
  edge  [fontname="Helvetica", fontsize=10, color="#5B6B7B", penwidth=1.3,
         fontcolor="#12324F"];

  rankdir=TB; nodesep=0.35; ranksep=0.5;
  compound=true;

  navigateur [shape=box, style="filled,rounded", fillcolor="#FFFFFF",
              label="Navigateur\ndu poste client"];

  subgraph cluster_hote {
    label="Hôte d'exécution (Docker Compose ou groupe de conteneurs)";
    fontsize=12; style=dashed; color="#000000"; bgcolor="#FFFFFF";

    proxy [shape=box3d, style=filled, fillcolor="#C9E4E2",
           label="Proxy inverse\nnginx\n:80"];

    subgraph cluster_front {
      label="Présentation"; fontsize=11; style=solid; bgcolor="#D7E5F2";
      front [shape=component, style=filled, fillcolor="#FFFFFF",
             label="Interface\nNext.js 14 · React 18\n:3000"];
    }

    subgraph cluster_back {
      label="Service applicatif"; fontsize=11; style=solid; bgcolor="#D7E5F2";
      api  [shape=component, style=filled, fillcolor="#FFFFFF",
            label="API REST\nFlask · JWT\n:5000"];
      ats  [shape=component, style=filled, fillcolor="#FFFFFF",
            label="Lecture de CV\nspaCy · Tesseract"];
      note [shape=component, style=filled, fillcolor="#FFFFFF",
            label="Notation\nrègles + modèle appris"];
      rag  [shape=component, style=filled, fillcolor="#FFFFFF",
            label="Assistant\nrecherche documentaire"];
    }

    bd [shape=cylinder, style=filled, fillcolor="#C9E4E2",
        label="PostgreSQL 16", height=1.0];
    fic [shape=folder, style=filled, fillcolor="#C9E4E2",
         label="Fichiers\nCV déposés"];
  }

  ollama [shape=box, style="filled,dashed", fillcolor="#F7E3B8",
          label="Ollama — facultatif\nmodèle de langage local\nà défaut, réponse\ndéterministe"];

  navigateur -> proxy   [label="  HTTPS  "];
  proxy -> front        [label="  /  "];
  proxy -> api          [label="  /api  "];
  front -> api          [style=dashed, label="  appels REST  "];
  api -> ats            [arrowhead=vee];
  api -> note           [arrowhead=vee];
  api -> rag            [arrowhead=vee];
  api -> bd             [label="  SQLAlchemy  "];
  ats -> fic            [label="  lit  "];
  rag -> ollama         [style=dashed, label="  HTTP local  "];
}
