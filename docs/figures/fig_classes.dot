digraph classes {

  graph [fontname="Helvetica", fontsize=11, bgcolor="#FFFFFF", pad=0.3,
         fontcolor="#12324F"];
  node  [fontname="Helvetica", fontsize=11, color="#12324F", penwidth=1.4,
         fontcolor="#12324F"];
  edge  [fontname="Helvetica", fontsize=10, color="#5B6B7B", penwidth=1.3,
         fontcolor="#12324F"];
  rankdir=TB;
  nodesep=1.0;
  ranksep=0.9;
  users [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#C9E4E2"><B>Utilisateur</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF">+ id : int &#171;PK&#187;<BR ALIGN="LEFT"/>+ email : String<BR ALIGN="LEFT"/>+ password_hash : String<BR ALIGN="LEFT"/>+ full_name : String<BR ALIGN="LEFT"/>+ is_active : bool<BR ALIGN="LEFT"/>+ status : String<BR ALIGN="LEFT"/>+ company : String<BR ALIGN="LEFT"/>+ phone : String<BR ALIGN="LEFT"/>+ approved_at : DateTime<BR ALIGN="LEFT"/>+ rejection_reason : String<BR ALIGN="LEFT"/>+ failed_logins : int<BR ALIGN="LEFT"/>+ locked_until : DateTime<BR ALIGN="LEFT"/>+ profil_declare : JSON<BR ALIGN="LEFT"/>+ deleted_at : DateTime<BR ALIGN="LEFT"/>+ created_at : DateTime<BR ALIGN="LEFT"/>+ role_id : int &#171;FK&#187;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#D7E5F2">+ set_password(mdp)<BR ALIGN="LEFT"/>+ check_password(mdp) : bool<BR ALIGN="LEFT"/>+ has_permission(code) : bool<BR ALIGN="LEFT"/>+ est_administrateur : bool<BR ALIGN="LEFT"/>+ est_verrouille : bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  roles [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#C9E4E2"><B>Rôle</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF">+ id : int &#171;PK&#187;<BR ALIGN="LEFT"/>+ name : String<BR ALIGN="LEFT"/>+ description : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#D7E5F2">+ to_dict() : dict<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  permissions [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#C9E4E2"><B>Permission</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF">+ id : int &#171;PK&#187;<BR ALIGN="LEFT"/>+ code : String<BR ALIGN="LEFT"/>+ description : String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  job_offers [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#C9E4E2"><B>Offre</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF">+ id : int &#171;PK&#187;<BR ALIGN="LEFT"/>+ title : String<BR ALIGN="LEFT"/>+ description : Text<BR ALIGN="LEFT"/>+ required_skills : JSON<BR ALIGN="LEFT"/>+ preferred_skills : JSON<BR ALIGN="LEFT"/>+ min_experience_years : int<BR ALIGN="LEFT"/>+ min_degree : String<BR ALIGN="LEFT"/>+ status : String<BR ALIGN="LEFT"/>+ location : String<BR ALIGN="LEFT"/>+ contract_type : String<BR ALIGN="LEFT"/>+ remote_policy : String<BR ALIGN="LEFT"/>+ salary_min : int<BR ALIGN="LEFT"/>+ salary_max : int<BR ALIGN="LEFT"/>+ salary_currency : String<BR ALIGN="LEFT"/>+ deleted_at : DateTime<BR ALIGN="LEFT"/>+ created_at : DateTime<BR ALIGN="LEFT"/>+ recruiter_id : int &#171;FK&#187;<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#D7E5F2">+ salaire_affiche : str<BR ALIGN="LEFT"/>+ is_deleted : bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  applications [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#C9E4E2"><B>Candidature</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF">+ id : int &#171;PK&#187;<BR ALIGN="LEFT"/>+ cv_path : String<BR ALIGN="LEFT"/>+ status : String<BR ALIGN="LEFT"/>+ score : float<BR ALIGN="LEFT"/>+ score_details : JSON<BR ALIGN="LEFT"/>+ created_at : DateTime<BR ALIGN="LEFT"/>+ candidate_id : int &#171;FK&#187;<BR ALIGN="LEFT"/>+ offer_id : int &#171;FK&#187;<BR ALIGN="LEFT"/>+ cv_empreinte : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#D7E5F2">+ is_deleted : bool<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  evaluations [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#C9E4E2"><B>Évaluation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF">+ id : int &#171;PK&#187;<BR ALIGN="LEFT"/>+ application_id : int &#171;FK&#187;<BR ALIGN="LEFT"/>+ notes : JSON<BR ALIGN="LEFT"/>+ verdict : String<BR ALIGN="LEFT"/>+ commentaire : Text<BR ALIGN="LEFT"/>+ score_systeme : float<BR ALIGN="LEFT"/>+ evaluateur_id : int &#171;FK&#187;<BR ALIGN="LEFT"/>+ created_at : DateTime<BR ALIGN="LEFT"/>+ updated_at : DateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  { rank=same; roles; permissions; }
  { rank=same; users; job_offers; }
  { rank=same; applications; evaluations; }
  roles -> users [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2];
  roles -> permissions [dir=both, arrowtail=none, arrowhead=none, constraint=false, taillabel="0..*", headlabel="0..*", labeldistance=2.2, label="attribue"];
  users -> job_offers [dir=both, arrowtail=odiamond, arrowhead=none, constraint=false, taillabel="1", headlabel="0..*", labeldistance=2.2, label="publie"];
  users -> applications [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, label="dépose"];
  job_offers -> applications [dir=both, arrowtail=odiamond, arrowhead=none, taillabel="1", headlabel="0..*", labeldistance=2.2, label="reçoit"];
  applications -> evaluations [dir=both, arrowtail=odiamond, arrowhead=none, constraint=false, taillabel="1", headlabel="0..1", labeldistance=2.2, label="est évaluée par"];
}
