digraph schema {

  graph [fontname="Helvetica", fontsize=11, bgcolor="#FFFFFF", pad=0.3,
         fontcolor="#12324F"];
  node  [fontname="Helvetica", fontsize=11, color="#12324F", penwidth=1.4,
         fontcolor="#12324F"];
  edge  [fontname="Helvetica", fontsize=10, color="#5B6B7B", penwidth=1.3,
         fontcolor="#12324F"];
  rankdir=TB;
  nodesep=0.35;
  ranksep=0.55;
  ai_metrics [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>ai_metrics</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>FK</B> application_id<BR ALIGN="LEFT"/><I>+ 2 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  applications [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>applications</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>FK</B> candidate_id<BR ALIGN="LEFT"/><B>FK</B> offer_id<BR ALIGN="LEFT"/><I>+ 6 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  evaluations [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>evaluations</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>FK</B> application_id<BR ALIGN="LEFT"/><B>FK</B> evaluateur_id<BR ALIGN="LEFT"/><I>+ 6 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  job_offers [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>job_offers</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>FK</B> recruiter_id<BR ALIGN="LEFT"/><I>+ 15 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  journal [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>journal</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>FK</B> auteur_id<BR ALIGN="LEFT"/><I>+ 7 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  notifications [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>notifications</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>FK</B> user_id<BR ALIGN="LEFT"/><I>+ 5 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  permissions [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>permissions</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>U</B> code<BR ALIGN="LEFT"/><I>+ 1 colonne</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  role_permissions [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#F7E3B8"><B>role_permissions</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK,FK</B> role_id<BR ALIGN="LEFT"/><B>PK,FK</B> permission_id<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  roles [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>U</B> name<BR ALIGN="LEFT"/><I>+ 1 colonne</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  signalements [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>signalements</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>FK</B> application_id<BR ALIGN="LEFT"/><B>FK</B> created_by_id<BR ALIGN="LEFT"/><B>FK</B> reviewed_by_id<BR ALIGN="LEFT"/><I>+ 9 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  token_blocklist [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>token_blocklist</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>U</B> jti<BR ALIGN="LEFT"/><I>+ 1 colonne</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  users [shape=plaintext, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" STYLE="ROUNDED"><TR><TD BGCOLOR="#C9E4E2"><B>users</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#FFFFFF"><B>PK</B> id<BR ALIGN="LEFT"/><B>U</B> email<BR ALIGN="LEFT"/><B>FK</B> role_id<BR ALIGN="LEFT"/><I>+ 13 colonnes</I><BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ai_metrics -> applications [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="application_id"];
  applications -> users [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="candidate_id"];
  applications -> job_offers [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="offer_id"];
  evaluations -> applications [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="application_id"];
  evaluations -> users [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="evaluateur_id"];
  job_offers -> users [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="recruiter_id"];
  journal -> users [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="auteur_id"];
  notifications -> users [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="user_id"];
  role_permissions -> roles [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="role_id"];
  role_permissions -> permissions [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="permission_id"];
  signalements -> applications [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="application_id"];
  signalements -> users [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="created_by_id"];
  signalements -> users [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="reviewed_by_id"];
  users -> roles [arrowhead=none, arrowtail=crow, dir=back, fontsize=9, label="role_id"];
}
